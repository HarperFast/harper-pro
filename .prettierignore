# core is a separate repo (github.com/HarperFast/harper), vendored as a git
# submodule; it owns its own formatting and CI.
/core/

# .claude/ is untracked local state (see .git/info/exclude), including every
# worktree under .claude/worktrees/ and that worktree's own core/ and dist/.
# Prettier reads .gitignore but not .git/info/exclude, so without this a
# whole-tree format run from the main checkout recurses into every worktree.
/.claude/
