{
	// Pro compiles core's source, so what that source assumes (lib, target, module settings)
	// comes from core's config. Set here only what is Pro's own.
	"extends": "./core/tsconfig.json",
	"include": [
		"replication/**/*",
		"security/**/*",
		"waf/**/*",
		"licensing/**/*",
		"analytics/**/*",
		"bin/**/*",
		"core/agent/**/*",
		"core/bin/**/*",
		"core/components/**/*",
		"core/config/**/*",
		"core/dataLayer/**/*",
		"core/json/**/*",
		"core/launchServiceSCripts/**/*",
		"core/resources/**/*",
		"core/security/**/*",
		"core/server/**/*",
		"core/sqlTranslator/**/*",
		"core/upgrade/**/*",
		"core/utility/**/*",
		"core/validation/**/*",
		"core/globals.js",
		"core/index.ts"
	],
	"compilerOptions": {
		"noEmit": false,
		"outDir": "dist",
		"noImplicitAny": false,
		// Codebase is not strict-clean yet; pin explicitly so a compiler upgrade
		// that flips this default (e.g. TypeScript 7) doesn't silently change results
		"strict": false,
		"sourceMap": true,

		// Allow .ts extensions in imports (will be transpiled to .js by esbuild)
		"rewriteRelativeImportExtensions": true,

		// TS7 removes baseUrl; paths are already relative to this file so this
		// resolves identically without it (verified: 0 resolution changes)
		"paths": {
			// Provide convenient path alias for compiled output
			// Change this to ./* once we're fully in TypeStrip land
			"@/*": ["./dist/*"]
		}
	}
}
